# Course Project local configuration reference
# The desktop/sidecar reads process environment variables. Do not commit real secrets.

# Live LLM integration. Disabled by default so deterministic/offline analysis remains usable.
# Set COURSE_PROJECT_LLM_ENABLED=1 only when endpoint/model/API key are configured.
COURSE_PROJECT_LLM_ENABLED=0
COURSE_PROJECT_LLM_ENDPOINT=
COURSE_PROJECT_LLM_MODEL=
COURSE_PROJECT_LLM_API_KEY_ENV=COURSE_PROJECT_LLM_API_KEY
COURSE_PROJECT_LLM_API_KEY=
COURSE_PROJECT_LLM_TIMEOUT_SECONDS=30
# Use json_object for providers that support OpenAI-compatible response_format;
# use prompt_only when they do not.
COURSE_PROJECT_LLM_STRUCTURED_OUTPUT=json_object

# Runtime / diagnostics
COURSE_PROJECT_LOG_LEVEL=INFO
COURSE_PROJECT_OUTPUT_DIR=outputs

# Optional feature flags. Heavy third-party analyzers should fail closed with
# dependency_unavailable rather than crashing the whole pipeline.
COURSE_PROJECT_ENABLE_NETZOB=0
COURSE_PROJECT_ENABLE_BINARYINFERNO=0
COURSE_PROJECT_ENABLE_NFSTREAM=0
