# Course Project local configuration
# Copy to .env for local development. Never commit real secrets.

# LLM integration. `mock` is the default and must remain usable for CI/offline development.
COURSE_PROJECT_LLM_PROVIDER=mock
COURSE_PROJECT_LLM_MODEL=mock-v1
COURSE_PROJECT_LLM_BASE_URL=
COURSE_PROJECT_LLM_API_KEY=
COURSE_PROJECT_LLM_TIMEOUT_SECONDS=60
COURSE_PROJECT_LLM_TEMPERATURE=0

# Runtime / diagnostics
COURSE_PROJECT_LOG_LEVEL=INFO
COURSE_PROJECT_OUTPUT_DIR=outputs

# Optional feature flags. Heavy third-party analyzers should fail closed with
# dependency_unavailable rather than crashing the whole pipeline.
COURSE_PROJECT_ENABLE_NETZOB=0
COURSE_PROJECT_ENABLE_BINARYINFERNO=0
COURSE_PROJECT_ENABLE_NFSTREAM=0
