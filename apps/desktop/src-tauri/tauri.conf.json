{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evidence Workbench",
  "version": "0.1.0",
  "identifier": "local.courseproject.evidence-workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Evidence Workbench",
      "width": 1320,
      "height": 860,
      "minWidth": 960,
      "minHeight": 640
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
