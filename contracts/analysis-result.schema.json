{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course-project.local/contracts/analysis-result.schema.json",
  "title": "AnalysisResult",
  "type": "object",
  "required": ["protocolVersion", "taskId", "status", "findings"],
  "properties": {
    "protocolVersion": {"type": "integer", "const": 1},
    "taskId": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "FAILED", "CANCELLED", "PARTIAL"]
    },
    "inputId": {"type": "string"},
    "resultRef": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId", "claim", "status", "evidenceIds"],
        "properties": {
          "findingId": {"type": "string"},
          "claim": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["ACCEPTED", "REJECTED", "UNCERTAIN"]
          },
          "semanticType": {"type": "string"},
          "evidenceIds": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "location": {
            "type": "object",
            "properties": {
              "inputId": {"type": "string"},
              "offset": {"type": "integer", "minimum": 0},
              "length": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "scores": {
            "type": "object",
            "properties": {
              "model": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence": {"type": "number", "minimum": 0, "maximum": 1},
              "verification": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
