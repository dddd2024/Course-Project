{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course-project.local/contracts/sidecar-message.schema.json",
  "title": "SidecarMessage",
  "type": "object",
  "required": ["protocolVersion", "id"],
  "properties": {
    "protocolVersion": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "method": {"type": "string"},
    "params": {"type": "object"},
    "event": {"type": "string", "enum": ["progress", "status"]},
    "stage": {"type": "string"},
    "progress": {"type": "number", "minimum": 0, "maximum": 1},
    "resultRef": {"type": "string"},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"required": ["method"]},
    {"required": ["event"]},
    {"required": ["resultRef"]},
    {"required": ["error"]}
  ],
  "additionalProperties": false
}
